{
  "name": "protimer",
  "productName": "ProTimer",
  "author": "Bigjoe Technology",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "ProTimer - Professional Multi-Timer & Stage Production Management",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-build-assets.cjs",
    "generate:icons": "node scripts/generate-icons.cjs",
    "prebuild": "node scripts/generate-icons.cjs",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "electron:dev": "electron .",
    "build": "vite build && node scripts/bundle-server.cjs",
    "dist": "node scripts/build-dist.cjs win",
    "dist:win": "node scripts/build-dist.cjs win",
    "dist:mac": "node scripts/build-dist.cjs mac",
    "dist:all": "node scripts/build-dist.cjs all",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','release','server.js'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": ">=1.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "@types/qrcode": ">=1.5.0",
    "@vitejs/plugin-react": ">=4.3.0",
    "dotenv": ">=16.4.0",
    "electron-updater": "^6.8.11",
    "express": ">=4.19.0",
    "idb": ">=8.0.0",
    "koffi": ">=2.9.0",
    "lucide-react": ">=0.460.0",
    "motion": ">=11.0.0",
    "qrcode": ">=1.5.3",
    "qrcode.react": ">=4.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "@types/express": ">=4.17.21",
    "@types/node": ">=20.0.0",
    "@types/react": ">=19.0.0",
    "@types/react-dom": ">=19.0.0",
    "autoprefixer": ">=10.4.19",
    "electron": ">=33.0.0",
    "electron-builder": ">=25.1.8",
    "esbuild": ">=0.24.0",
    "tailwindcss": ">=4.0.0",
    "tsx": ">=4.19.0",
    "typescript": ">=5.6.0"
  }
}
